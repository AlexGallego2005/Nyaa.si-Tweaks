{
  "manifest_version": 3,
  "name": "Nyaa.si Tweaks - Beta",
  "version": "0.9.1",
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/assets/html/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://nyaa.si/downloads"],
      "run_at": "document_idle",
      "js": [
        "src/modules/storage.js",
        "src/modules/downloads.js"
      ]
    },
    {
      "matches": ["https://nyaa.si/view/*"],
      "run_at": "document_idle",
      "js": [
        "src/modules/storage.js",
        "src/modules/webpage.js",
        "src/modules/view.js"
      ]
    },
    {
      "matches": ["https://nyaa.si/*"],
      "run_at": "document_idle",
      "js": [
        "src/modules/storage.js",
        "src/modules/webpage.js",
        "src/modules/events.js",
        "src/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["https://nyaa.si/*"],
      "resources": [
        "src/assets/*"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "./icons/icon16.png",
    "48": "./icons/icon48.png",
    "128": "./icons/icon128.png"
  }
}